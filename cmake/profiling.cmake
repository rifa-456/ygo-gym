option(YGO_PROFILE_SYMBOLS "Build optimized native code with profiling symbols" OFF)
option(YGO_CLONE_DIAGNOSTICS "Compile clone phase timers and work counters" OFF)

function(ygo_configure_profiling)
    if(YGO_CLONE_DIAGNOSTICS)
        target_compile_definitions(ocgcore PUBLIC OCG_CLONE_PROFILING=1)
    endif()
    if(YGO_PROFILE_SYMBOLS)
        target_compile_definitions(_native PRIVATE YGO_PROFILE_SYMBOLS=1)
        foreach(profile_target IN ITEMS ocg_lua ocgcore _native)
            if(MSVC)
                target_compile_options(${profile_target} PRIVATE /Zi /FS)
            else()
                target_compile_options(${profile_target} PRIVATE -g)
            endif()
        endforeach()
        if(MSVC)
            target_link_options(_native PRIVATE /DEBUG:FULL /INCREMENTAL:NO /OPT:REF /OPT:ICF)
            install(FILES "$<TARGET_PDB_FILE:_native>" DESTINATION ygo_gym OPTIONAL)
        endif()
    endif()
endfunction()
