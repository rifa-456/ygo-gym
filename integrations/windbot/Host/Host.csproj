<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>NET</DefineConstants>
    <WindBotRoot Condition="'$(WindBotRoot)' == ''">../../../third_party/WindBot</WindBotRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="$(WindBotRoot)/ExecutorBase/Game/**/*.cs" />
    <Compile Include="$(WindBotRoot)/ExecutorBase/YGOSharp.OCGWrapper.Enums/*.cs" />
    <Compile Include="$(WindBotRoot)/ExecutorBase/YGOSharp.OCGWrapper/Card.cs" />
    <Compile Include="$(WindBotRoot)/ExecutorBase/YGOSharp.OCGWrapper/NamedCard.cs" />
    <Compile Include="$(WindBotRoot)/Game/AI/**/*.cs" />
    <Compile Include="$(WindBotRoot)/Game/GameBehavior.cs" />
    <Compile Include="$(WindBotRoot)/Game/GamePacketFactory.cs" />
    <Compile Include="$(WindBotRoot)/Game/Room.cs" />
    <Compile Include="$(WindBotRoot)/YGOSharp.Network/Enums/*.cs" />
    <Compile Include="$(WindBotRoot)/YGOSharp.Network/Utils/BinaryExtensions.cs" />
  </ItemGroup>
</Project>
